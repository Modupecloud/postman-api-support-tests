          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 or 401 depending on route policy\", function () {\r\n    pm.expect(pm.response.code).to.be.oneOf([200, 401]);\r\n});"
            ]
          }
        }
      ],
